# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=HizuDb;Username=admin;Password=admin

# JWT Configuration
Jwt__Secret=YourSuperSecretKeyWithAtLeast32CharactersLongForHS256Security!
Jwt__Issuer=HizuApi
Jwt__Audience=HizuClient
Jwt__ExpiryMinutes=1440

# CORS
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000

# -------------------------------------------------------------
# Iran SMS Gateway Configuration (کاوه نگار / فراز اس ام اس / ملی پیامک / قاصدک)
# -------------------------------------------------------------
# Options: Mock | Kavenegar | FarazSms | IPPanel | Melipayamak | Ghasedak | Generic
Sms__Provider=Mock
Sms__ApiKey=your_sms_api_key_or_panel_password
Sms__SenderNumber=10008000
# For Melipayamak:
Sms__UserName=
# Admin Phone Number for Order Alerts (Default: 09101854076)
Sms__AdminPhoneNumbers__0=09101854076

# -------------------------------------------------------------
# Email Configuration (SMTP / Liara Mail / Gmail / cPanel Host)
# -------------------------------------------------------------
Email__Enabled=false
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__UserName=as.masoud.1868@gmail.com
Email__Password=your_app_password_here
Email__FromAddress=noreply@hizu.ir
Email__FromName=هیزو | استودیو طراحی و ساخت دیجیتال
# Admin Email for Full Order Details (Default: as.masoud.1868@gmail.com)
Email__AdminEmails__0=as.masoud.1868@gmail.com
